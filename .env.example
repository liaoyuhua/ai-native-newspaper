# 高档（研究 / 写作）
# 例：Kimi K3
#   LLM_API_KEY=sk-xxx
#   LLM_BASE_URL=https://api.moonshot.cn/v1   # 国内；国际站用 https://api.moonshot.ai/v1
#   LLM_MODEL=kimi-k3
LLM_API_KEY=
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k3

# 高档额外参数。Kimi K3 推荐 {"reasoning_effort":"max"}；不需要就留空
LLM_EXTRA_KWARGS={"reasoning_effort":"max"}
# Kimi K3 必须设为 1；其他模型可留空
LLM_TEMPERATURE=1

# 便宜供应商（可选）。配了之后，轻量阶段可走另一套 key/base_url
# 例：DeepSeek
#   LLM_CHEAP_API_KEY=sk-xxx
#   LLM_CHEAP_BASE_URL=https://api.deepseek.com
#   LLM_CHEAP_MODEL=deepseek-v4-flash
#   LLM_MID_MODEL=deepseek-v4-pro
LLM_CHEAP_API_KEY=
LLM_CHEAP_BASE_URL=
LLM_CHEAP_MODEL=
LLM_MID_MODEL=
# LLM_CHEAP_TEMPERATURE=
# LLM_CHEAP_EXTRA_KWARGS=

# 各阶段模型；不填则：聚类/核查→CHEAP，选题评语→MID 或 CHEAP，研究/写作→LLM_MODEL
# LLM_MODEL_TOPIC_CLUSTERING=deepseek-v4-flash
# LLM_MODEL_TOPIC_SCORING=deepseek-v4-pro
# LLM_MODEL_FACTCHECK=deepseek-v4-flash
# LLM_MODEL_EDITORIAL=deepseek-v4-pro
# LLM_MODEL_MECHANISM=deepseek-v4-pro
# LLM_MODEL_RESEARCH_AGENT=kimi-k3
# LLM_MODEL_WRITING=kimi-k3
# 主写作模型额度耗尽时的显式降级模型；文章元数据会记录实际模型
# LLM_MODEL_WRITING_FALLBACK=deepseek-v4-pro

# Weekly Deep Dive 选题质量闸门。分数为 1–5；达不到时该周正式跳过发布。
TOPIC_SHORTLIST_SIZE=5
TOPIC_PROBE_SIZE=3
TOPIC_PROBE_DOCS_PER_CANDIDATE=2
TOPIC_MIN_EDITORIAL_SCORE=3.6
TOPIC_MIN_FEASIBILITY_SCORE=3.4
ARTICLE_MIN_FINAL_SCORE=3.5
ARTICLE_CLAIM_AUDIT_ROUNDS=3

# 信源连续失败后的隔离与重试策略
SOURCE_QUARANTINE_AFTER_FAILURES=3
SOURCE_QUARANTINE_RETRY_HOURS=24

# 可选：Semantic Scholar API Key（深度研究扩展检索，不填也能跑，只是限流更严）
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# 本地调试"创建提案 Issue"时需要（GitHub Actions 会自动用内置 GITHUB_TOKEN）
GITHUB_TOKEN=
GITHUB_REPOSITORY=your-name/ai_native_newspaper
